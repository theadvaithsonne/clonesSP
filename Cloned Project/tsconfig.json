{
  "compilerOptions": {
    "target": "ES2017",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": false, // turns off a bunch of strict checks
    "noImplicitAny": false, // specifically allow implicit any
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": ["./*"]
    }
  },
  "include": ["next-env.d.ts", "**/*.ts", "**/*.tsx", ".next/types/**/*.ts"],
  // server/ (and the backend scripts that import it) compile with
  // server/tsconfig.json — CommonJS, strict — not with the Next.js settings.
  "exclude": ["node_modules", "server", "dist", "scripts/*.ts"]
}
