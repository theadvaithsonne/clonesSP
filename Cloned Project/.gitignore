# ── dependencies ────────────────────────────────────────────────
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# ── build output ────────────────────────────────────────────────
# Next.js
/.next/
/out/
/build
# Compiled server (server/ → dist/ via `npm run build:server`)
/dist/
/coverage
*.tsbuildinfo
next-env.d.ts

# ── env files & secrets ─────────────────────────────────────────
# .env (backend + combined server) and .env.local (frontend) hold live
# credentials. Only the key list in .env.example is committed.
.env*
!.env.example
*.pem

# ── logs ────────────────────────────────────────────────────────
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
error.txt

# ── data dumps (live user PII) ──────────────────────────────────
# Backups from server/scripts/deleteTestOrgs.ts and the bat246 scripts
# (JSON snapshots taken before destructive operations).
backups/

# Repo-root JSON outputs from ad-hoc DB scripts — these contain live
# user PII (emails, phone numbers, userIds). Scripts must write logs
# either to backups/ or to /tmp, NEVER to the repo root.
# Do NOT remove this line: PII was accidentally committed once
# (backend 7017d1a) and this stops it from happening again.
/phone-*.json
/user-*.json
/audit-*.json
/dedupe-*.json
/normalize-*.json

# ── large media ─────────────────────────────────────────────────
# The site's own videos in public/ are part of the app and stay tracked.
*.mp4
*.tiff
*.avi
*.flv
*.mov
*.wmv
!public/**/*.mp4

# ── tooling / OS ────────────────────────────────────────────────
.DS_Store
Thumbs.db
.vercel
.idea/
*.code-workspace
TEST*.xml
*.class
*.py[cod]
*.jar
target/
*.exe
*.war
