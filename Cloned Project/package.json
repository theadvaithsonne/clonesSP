{
  "name": "garage",
  "version": "0.1.0",
  "private": true,
  "description": "Garage 2.0 — Next.js frontend and Express/Socket.IO backend served by one Node process (server/main.ts).",
  "scripts": {
    "dev": "tsx watch --clear-screen=false --exclude \"./.next/**\" --exclude \"./**/*.md\" server/main.ts --dev",
    "build": "npm run build:web && npm run build:server",
    "start": "node dist/main.js",
    "dev:web": "next dev --turbopack",
    "build:web": "next build --turbopack && npm run sentry:sourcemaps:admin",
    "start:web": "next start",
    "dev:backend": "tsx watch server/index.ts",
    "build:server": "tsc -p server/tsconfig.json && node scripts/copy-server-assets.mjs",
    "start:backend": "node dist/index.js",
    "lint": "eslint",
    "typecheck:server": "tsc --noEmit -p server/tsconfig.json",
    "test": "jest",
    "test:watch": "jest --watch",
    "sentry:sourcemaps:admin": "node scripts/upload-admin-sourcemaps.mjs",
    "test:knock": "tsx scripts/test-knock-push.ts",
    "teamforce:backfill-clock": "tsx server/scripts/teamforce-backfill-clock.ts",
    "teamforce:backfill-clock:prod": "node dist/scripts/teamforce-backfill-clock.js",
    "auction:diagnose": "tsx server/scripts/diagnoseAuctionSettlement.ts",
    "backfill:downline-tree": "tsx server/scripts/backfill-downline-tree.ts",
    "backfill:downline-tree:prod": "node dist/scripts/backfill-downline-tree.js",
    "indexes:sync": "tsx server/scripts/sync-indexes.ts",
    "indexes:sync:prod": "node dist/scripts/sync-indexes.js"
  },
