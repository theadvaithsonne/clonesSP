                    <div className="flex gap-2 flex-wrap">
                      {assignCardMemberlist.map((m, i) => {
                        const initials = m?.name
                          ? m?.name
                            .split(" ")
                            .slice(0, 2)
                            .map((n) => n[0]?.toUpperCase())
                            .join("")
