      break-words                /* break very long words if needed */
      min-h-[1.75rem]            /* give it some vertical room; adjust as needed */
    "
                  placeholder="Card Title"
                />
              </div>
            </div>
          </div>
        </div>

        {/* Main Grid Layout */}
        <div className="px-8 pb-8 grid grid-cols-1 md:grid-cols-[1fr_192px] gap-8">

          {/* LEFT COLUMN */}
          <div className="space-y-6 min-w-0">

            {/* Meta Data Row */}


        <div className="flex flex-wrap gap-6 ">
              {isLoadingAssign ? (
                <div>
                  <div className="flex items-center mb-2 gap-2 text-xs font-medium text-white/50">
                    <Users className="h-4 w-4" />
