                                  const socketId = undefined;
                                  await updateCard(card._id, { assignedToIds: updatedIds as any, socketId, userRemoveAssignedToIds: m?._id });

                                  // Optimistic UI update via store
                                  if (memberId) { removeAssignedMember(memberId); }

                                  setColumns(prev =>
