                    Members
                  </button>
                </PopoverTrigger>
                <PopoverContent side="right" align="start" className="w-72 p-0 dark:bg-gray-800" sideOffset={10}>

                  <div className="p-3">
                    <input
                      type="text"
                      placeholder="Search members..."
                      value={memberSearchTerm}
                      onChange={(e) => setMemberSearchTerm(e.target.value)}
                      onBlur={(e) => e.target.blur()}
                      className="w-full px-3 py-2 border border-gray-200 dark:bg-gray-500 dark:text-white/50rounded text-xs mb-3 focus:outline-none ring-0 focus:ring-0 focus:border-[#1f2937]"
                    />
                    <div className="space-y-1">
                      <div className="text-xs font-semibold text-white/50 mb-2">
                        {memberSearchTerm.trim() ? "Search results" : "Board members"}
                      </div>

                      {/* Scrollable container with fixed height */}
                      <div className="max-h-80 overflow-y-auto pr-1"> {/* 400px ≈ max-h-96 in Tailwind */}
                        {isMembersLoading || isSearchingMembers ? (
                          Array.from({ length: 5 }).map((_, i) => (
                            <div key={i} className="flex items-center gap-2 p-2">
                              <Skeleton className="w-7 h-7 rounded-full" />
                              <Skeleton className="h-4 w-24" />
                            </div>
                          ))
                        ) : memberSearchTerm.trim() ? (
                          // Show search results
                          searchedMembers.length > 0 ? (
                            searchedMembers.map((member, index) => {
                              const colorIndex = index % avatarColors.length
                              return (
                                <button
                                  key={member._id || member.id}
                                  className="w-full flex items-center justify-between p-2 hover:bg-gray-100 rounded group transition disabled:opacity-60 disabled:cursor-not-allowed"
                                  onClick={() => toggleMember(member)}
                                  disabled={togglingMemberIds.size > 0}
                                >
                                  <div className="flex items-center gap-2">
                                    <div
                                      className={`bg-blue-900 w-7 h-7 rounded-full text-white/50flex items-center justify-center text-xs font-bold`}>
                                      {member?.name?.substring(0, 2).toUpperCase() || member?.email?.substring(0, 2).toUpperCase() || "??"}
                                    </div>
                                    <span className="text-xs text-white/50">
                                      {member?.name || member?.email || "Unknown"}
                                    </span>
                                  </div>
                                  {member._id && togglingMemberIds.has(member._id) && (
                                    <div className="w-3 h-3 border-2 border-[#1f2937] border-t-transparent rounded-full animate-spin" />
                                  )}
                                </button>
                              )
                            })
                          ) : (
                            <div className="text-xs text-white/50 text-center py-4">
                              No members found
                            </div>
                          )
                        ) : (
                          // Show all board members when not searching
                          cardMembers?.map((member, index) => {
                            const colorIndex = index % avatarColors.length
                            return (
                              <button
                                key={member.id}
                                className="w-full flex items-center justify-between p-2 hover:bg-gray-100  dark:hover:bg-gray-700 rounded group transition disabled:opacity-60 disabled:cursor-not-allowed"
                                onClick={() => toggleMember(member)}
                                disabled={togglingMemberIds.size > 0}
                              >
                                <div className="flex items-center gap-2">
                                  <div

                                    className={`bg-blue-900 w-7 h-7 rounded-full text-white/50flex items-center justify-center text-xs font-bold`}>
                                    {member?.name?.substring(0, 2).toUpperCase()}
                                  </div>
                                  <span className="text-xs text-white/50">
                                    {member?.name}
                                  </span>
                                </div>
                                {member._id && togglingMemberIds.has(member._id!) && (
                                  <div className="w-3 h-3 border-2 border-[#1f2937] border-t-transparent rounded-full animate-spin" />
                                )}
                              </button>
                            )
                          })
                        )}
                      </div>
                    </div>
                  </div>
                </PopoverContent>
              </Popover>

              <Popover open={isLabelPopoverOpen} onOpenChange={setIsLabelPopoverOpen}>
                <PopoverTrigger asChild>

                  <button
                    className="w-full flex border border-white/10 items-center gap-2 px-3 py-1.5 hover:bg-white/5 text-white/50 text-xs rounded font-medium transition bg-transparent"
                  >
                    <Tag className="w-4 h-4 text-white/50 dark:text-white/50" />
                    Labels
                  </button>

                </PopoverTrigger>
                <PopoverContent className="w-80 p-0 rounded-lg shadow-xl dark:bg-gray-800 dark:border-gray-700" align="start">
                  <div className="flex flex-col h-[400px]">
                    <div className="px-4 py-3 border-b dark:border-gray-700 bg-gray-50 dark:bg-gray-900 rounded-t-lg flex items-center justify-between sticky top-0 z-10">
                      <h4 className="font-semibold text-sm text-white/50 dark:text-white/50">
                        {isCreatingLabel ? (isEditingLabel ? "Edit Label" : "Create Label") : "Labels"}
                      </h4>
                      {isCreatingLabel && (
                        <button
                          onClick={() => {
                            setIsCreatingLabel(false)
                            setEditingTagId(null)
                            setIsEditingLabel(false)
                            setNewLabelName("")
                          }}
                          className="p-1 hover:bg-gray-200 dark:hover:bg-gray-700 rounded-full transition"
                        >
                          <ChevronLeft className="w-4 h-4 text-white/50 dark:text-white/50" />
                        </button>
                      )}
                    </div>

                    <div className="flex-1 overflow-y-auto px-4 py-3">
                      {isCreatingLabel ? (
                        <div className="space-y-4">
                          <div>
                            <label className="text-xs font-bold text-white/50 dark:text-white/50 uppercase tracking-wide block mb-2">Name</label>
                            <input
                              value={newLabelName}
                              onChange={(e) => setNewLabelName(e.target.value)}
                              placeholder="Label name (optional)"
                              className="w-full px-3 py-2 text-sm text-white/50 dark:text-white/50 bg-white dark:bg-gray-700 border border-gray-200 dark:border-gray-600 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500"
                              autoFocus
                            />
                          </div>
                          <div>
                            <label className="text-xs font-bold text-white/50 dark:text-white/50 uppercase tracking-wide block mb-2">Color</label>
                            <div className="grid grid-cols-5 gap-2">
                              {LABEL_COLORS.map((color) => (
                                <button
                                  key={color}
                                  onClick={() => setSelectedColor(color)}
                                  className={`${color} h-8 rounded-md transition-transform hover:scale-105 hover:shadow-md relative ring-2 ${selectedColor === color ? 'ring-offset-2 ring-gray-400 dark:ring-gray-500' : 'ring-transparent'}`}
                                >
                                  {selectedColor === color && (
                                    <div className="absolute inset-0 flex items-center justify-center">
                                      <Check className="w-4 h-4 text-white" />
                                    </div>
                                  )}
                                </button>
                              ))}
                            </div>
                          </div>
                          <div className="flex items-center justify-between pt-4 border-t dark:border-gray-700">
                            {isEditingLabel && (
                              <button
                                onClick={() => editingTagId && handleDeleteTag(editingTagId)}
                                className="px-4 py-2 bg-red-50 hover:bg-red-100 text-red-600 dark:bg-red-900/20 dark:hover:bg-red-900/30 dark:text-red-400 rounded-md text-sm font-medium transition"
                              >
                                Delete
                              </button>
                            )}
                            <div className="flex gap-2 ml-auto">
                              <button
                                onClick={handleCreateLabel}
                                disabled={isTagLoading}
                                className="px-4 py-2 bg-gray-900 dark:bg-gray-100 hover:bg-gray-800 dark:hover:bg-gray-200 text-white/50dark:text-white/50 rounded-md text-sm font-medium transition shadow-sm disabled:opacity-50"
                              >
                                {isTagLoading ? "Saving..." : (isEditingLabel ? "Save" : "Create")}
                              </button>
                            </div>
                          </div>
                        </div>
                      ) : (
                        <div className="space-y-3">
                          <input
                            placeholder="Search labels..."
                            value={searchLabel}
                            onChange={(e) => setSearchLabel(e.target.value)}
                            className="w-full px-3 py-2 text-sm text-white/50 dark:text-white/50 bg-white dark:bg-gray-700 border border-gray-200 dark:border-gray-600 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500 mb-3"
                          />

                          <div className="space-y-1">
                            <label className="text-xs font-bold text-white/50 dark:text-white/50 uppercase tracking-wide block mb-2">Available Labels</label>
                            {isFetchingTags ? (
                              <div className="py-4 text-center text-white/50 dark:text-white/50 text-xs">Loading tags...</div>
                            ) : fetchedTagData.length > 0 ? (
                              fetchedTagData
                                .filter(tag => tag.name.toLowerCase().includes(searchLabel.toLowerCase()))
                                .map(tag => {
                                  const isSelected = displayTagData.some(t => t._id === tag._id)
                                  return (
                                    <div key={tag._id} className="flex item-center gap-2 group">
                                      <button
                                        onClick={() => !togglingTagId && handleToggleTag(tag)}
                                        className={`flex-1 flex items-center justify-between px-3 py-2 rounded-md transition-all hover:pl-4 group relative overflow-hidden ${tag.color} text-white/50shadow-sm`}
                                        disabled={!!togglingTagId}
                                      >
                                        <span className="font-semibold text-sm truncate pr-2">{tag.name}</span>
                                        {isSelected && (
                                          <div className="bg-white/20 p-0.5 rounded-full">
                                            <Check className="w-3.5 h-3.5" />
                                          </div>
                                        )}
                                      </button>
                                      <button
                                        onClick={(e) => {
                                          e.stopPropagation()
                                          startEditLabel(tag)
                                        }}
                                        className="p-2 text-white/50 dark:text-white/50 hover:text-white/50 dark:hover:text-white/50hover:bg-gray-100 dark:hover:bg-gray-700 rounded-md transition"
                                      >
                                        <CreditCard className="w-4 h-4" />
                                      </button>
                                    </div>
                                  )
                                })
                            ) : (
                              <div className="py-8 text-center text-white/50 dark:text-white/50 text-xs italic">
                                No labels found. Create one to get started!
                              </div>
                            )}
                          </div>
                        </div>
                      )}
                    </div>
                    {!isCreatingLabel && (
                      <div className="p-3 border-t dark:border-gray-700 bg-gray-50 dark:bg-gray-900 rounded-b-lg">
                        <button
                          onClick={() => {
                            setNewLabelName(searchLabel) // Pre-fill with search term if any
                            setIsCreatingLabel(true)
                          }}
                          className="w-full py-2 bg-gray-200 dark:bg-gray-700 hover:bg-gray-300 dark:hover:bg-gray-600 text-white/50 dark:text-white/50 rounded-md text-sm font-medium transition"
                        >
                          Create a new label
                        </button>
                      </div>
                    )}
                  </div>
                </PopoverContent>
              </Popover>

              <Popover open={isChecklistPopoverOpen} onOpenChange={(open) => { setIsChecklistPopoverOpen(open); if (open) setNewTaskName("") }}>
                <PopoverTrigger asChild>
                  <button
                    className="w-full flex border border-white/10 items-center gap-2 px-3 py-1.5 hover:bg-white/5 text-white/50 text-xs rounded font-medium transition bg-transparent"
                    disabled={isReadOnly}
                  >
                    <CheckSquare className="w-4 h-4" /> Task
                  </button>
                </PopoverTrigger>
                <PopoverContent side="bottom" align="start" className="w-[300px] p-3 shadow-xl border-gray-200" sideOffset={8}>
                  <div className="space-y-2">
                    <div className="text-xs font-semibold text-white/50">Add Task</div>
                    <input
                      type="text"
                      placeholder="Task name..."
                      value={newTaskName}
                      onChange={(e) => setNewTaskName(e.target.value)}
                      onKeyDown={(e) => {
                        if (e.key === 'Enter' && newTaskName.trim() && !isCreatingTask) {

                          createTask(card._id, newTaskName.trim(), "boardSocketService.socketId");

                          setNewTaskName("")
                          setIsChecklistPopoverOpen(false)
                        }
                      }}
                      disabled={isCreatingTask}
                      className="w-full px-3 py-2 border border-gray-200 rounded text-xs focus:outline-none focus:border-[#1f2937] disabled:opacity-60 disabled:cursor-not-allowed"
                      autoFocus
                    />
                    <button
                      className="w-full bg-[#1f2937] text-white/50text-xs font-medium py-1.5 rounded hover:bg-[#5B21B6] transition disabled:opacity-60 disabled:cursor-not-allowed"
                      onClick={() => {
                        if (newTaskName.trim() && !isCreatingTask) {

                          createTask(card._id, newTaskName.trim(), "boardSocketService.socketId");

                          setNewTaskName("")
                          setIsChecklistPopoverOpen(false)
                        }
                      }}
                      disabled={isCreatingTask || !newTaskName.trim()}
                    >
                      {isCreatingTask ? "Adding..." : "Add"}
                    </button>
                  </div>
                </PopoverContent>
              </Popover>

              <Popover open={isDatesPopoverOpen} onOpenChange={setIsDatesPopoverOpen}>
                <PopoverTrigger asChild>
                  <button className="w-full flex border border-white/10 items-center gap-2 px-3 py-1.5 hover:bg-white/5 text-white/50 text-xs rounded font-medium transition bg-transparent" disabled={isReadOnly}>
                    <Clock className="w-4 h-4" /> Dates
                  </button>
                </PopoverTrigger>
                <PopoverContent className="w-64 p-0 rounded-lg shadow-xl dark:bg-gray-800 dark:border-gray-700 font-sans" align="start">
                  <div className="px-4 py-3 border-b dark:border-gray-700 bg-gray-50 dark:bg-gray-900 rounded-t-lg">
                    <h4 className="font-semibold text-sm text-white/50 dark:text-white/50">Dates</h4>
                  </div>
                  <div className="p-4 space-y-5">
                    <div>
                      <label className="text-xs font-bold text-white/50 block mb-1">Start date</label>
                      <div className="flex items-center gap-2">
                        <input
                          type="checkbox"
                          checked={isStartDateEnabled}
                          onChange={(e) => {
                            if (blockIfReadOnly()) return
                            const enabled = e.target.checked
                            setIsStartDateEnabled(enabled)
                            if (enabled && !startDate) setStartDate(new Date())
                          }}
                          className="w-4 h-4 rounded border-gray-300 dark:border-gray-600 text-[#1f2937] focus:ring-[#1f2937] bg-white dark:bg-gray-700"
                          disabled={isReadOnly}
                        />

                        <div className={`flex-1 flex items-center gap-3 bg-white dark:bg-gray-700 rounded px-3 py-2 border ${isStartDateEnabled ? 'border-[#1f2937] bg-white' : 'border-gray-200'}`}>
                          <PlayCircle className="w-4 h-4 text-green-600 flex-shrink-0" />
                          <input
                            type="date"
                            value={formatInputDate(startDate)}
                            min={formatInputDate(today)}
                            onChange={(e) => {
                              if (blockIfReadOnly()) return
                              setStartDate(e.target.value ? new Date(e.target.value) : undefined)
                            }}
                            onBlur={(e) => e.target.blur()}
                            disabled={!isStartDateEnabled || isReadOnly}
                            className="bg-transparent w-full text-xs outline-none text-white/50 dark:text-white/50 placeholder-gray-400"
                          />
                        </div>
                      </div>
                    </div>

                    <div>
                      <label className="text-xs font-bold text-white/50 block mb-1">Due date</label>
                      <div className="flex items-center gap-2">
                        <input
                          type="checkbox"
                          checked={hasDueDate}
                          onChange={(e) => {
                            if (blockIfReadOnly()) return
                            const enabled = e.target.checked
                            setHasDueDate(enabled)
                            if (enabled && !dueDate) setDueDate(startDate || today)
                          }}
                          className="w-4 h-4 rounded border-gray-300 dark:border-gray-600 text-[#1f2937] focus:ring-[#1f2937] bg-white dark:bg-gray-700"
                          disabled={isReadOnly}
                        />
                        <div className="flex-1 flex items-center gap-3 bg-white dark:bg-gray-700 rounded px-3 py-2 border border-[#1f2937] dark:border-gray-500">
                          <Flag className="w-4 h-4 text-red-600 flex-shrink-0" />
                          <input
                            type="date"
                            value={formatInputDate(dueDate)}
                            min={formatInputDate(startDate || today)}
                            onChange={(e) => {
                              if (blockIfReadOnly()) return
                              setDueDate(e.target.value ? new Date(e.target.value) : undefined)
                            }}
                            onBlur={(e) => e.target.blur()}
                            disabled={!hasDueDate || isReadOnly}
                            className="bg-transparent w-full text-xs outline-none text-white/50 dark:text-white/50"
                          />
                        </div>
                      </div>
                    </div>

                    <div className="space-y-2 pt-2">
                      <button
                        className="w-full bg-[#1f2937] hover:bg-[#5B21B6] dark:bg-gray-100 dark:text-white/50 text-white/50font-medium text-xs py-2 rounded transition disabled:opacity-60"
                        onClick={handleSaveDates}
                        disabled={isSavingDates}
                      >
                        {isSavingDates ? "Saving..." : "Save"}
                      </button>
                      <button
                        className="w-full bg-white dark:bg-gray-700 hover:bg-gray-100 dark:hover:bg-gray-600 border border-gray-300 dark:border-gray-600 text-white/50 dark:text-white/50font-medium text-xs py-2 rounded transition disabled:opacity-60"
                        onClick={handleRemoveDates}
                        disabled={isSavingDates}
                      >
                        Remove
                      </button>
                    </div>
                  </div>
                </PopoverContent>
              </Popover>

              <button onClick={() => setShowAttachments(true)} className="w-full flex border border-white/10 items-center gap-2 px-3 py-1.5 hover:bg-white/5 text-white/50 text-xs rounded font-medium transition bg-transparent">
                <Paperclip className="w-4 h-4" /> Attachment
              </button>
            </div>
            <div>
              <div className="text-xs font-semibold text-white/50 dark:text-white/50 uppercase mt-8 mb-6">Actions</div>
              <button
                onClick={handleToggleComplete}
                className={`flex items-center gap-2 w-full flex items-center gap-2 px-3 py-1.5 text-xs font-medium transition disabled:opacity-60 ${card?.isCompleted
                  ? "bg-green-500/20 text-green-400 hover:bg-green-500/30"
                  : "bg-white/5 text-white/50 hover:bg-white/10"
                  }`}
              >
                <CheckSquare className="w-4 h-4" />
                {card?.isCompleted ? "Completed" : "Mark Complete"}
              </button>


              <div className="mt-0">
                <button onClick={handleDelete} className="w-full mt-2 flex items-center gap-2 px-3 py-1.5 bg-red-500/10 hover:bg-red-500/20 text-red-500 rounded text-xs font-medium transition disabled:opacity-60" disabled={isReadOnly}>
                  <Trash2 className="w-4 h-4" /> Delete
                </button>
              </div>
            </div>
          </div>

        </div>
      </div >

    </div >
  )
}

// Sub-component for individual Task item to manage its own checklist
function TaskItem({
  task,
  boardId,
  cardId,
  isReadOnly,
  setColumns,
  taskchild,
  card,

}: {
  task: any
  boardId: string
  cardId: string
  isReadOnly?: boolean
  setColumns: React.Dispatch<React.SetStateAction<Column[]>>
  card: Card
  taskchild: any
}) {
  const { updateTask, deleteTask, tasks } = useTaskStore()

  // Helper function to update card TaskDataCount with deltas


  // Initialize with nested data
  const [checklistitems, setchecklistitems] = useState<any[]>(task.checklistData || [])
  const [newItemInput, setNewItemInput] = useState("")
  const [isAddingChecklistItem, setIsAddingChecklistItem] = useState(false)

  // Checklist pagination state
  const [checklistCurrentPage, setChecklistCurrentPage] = useState(1)
  const [checklistTotalPages, setChecklistTotalPages] = useState(1)
  const [hasMoreChecklists, setHasMoreChecklists] = useState(true)
  const [isLoadingMoreChecklists, setIsLoadingMoreChecklists] = useState(false)

  // Task Title Edit State
  const [isEditingTitle, setIsEditingTitle] = useState(false)
  const [titleInput, setTitleInput] = useState(task.name)

  // Checklist Item Edit State
  const [editingItemId, setEditingItemId] = useState<string | null>(null)
  const [editItemValue, setEditItemValue] = useState("")
  const [togglingItemId, setTogglingItemId] = useState<string | null>(null)

  // Local Counts State
  const [localCounts, setLocalCounts] = useState({
    total: task?.childCount || 0,
    completed: task?.completedChildCount || 0
  })

  // Sync if task prop updates (e.g. after re-fetch of tasks)
  useEffect(() => {
    if (task.checklistData) {
      setchecklistitems(task.checklistData)
      // Initialize pagination: if childCount > items.length, there might be more pages
      // const initialHasMore = task.childCount > (task.checklistData?.length || 0)
      // setHasMoreChecklists(initialHasMore)
      setChecklistCurrentPage(1)
      //setChecklistTotalPages(initialHasMore ? 2 : 1) // Assume at least 2 pages if hasMore
    }
    setLocalCounts({
      total: task?.childCount || 0,
      completed: task?.completedChildCount || 0
    })
  }, [task.checklistData, task.childCount, task.completedChildCount])
  const updateTaskAndCardCounts = (newChildCount: number, newCompletedChildCount: number) => {
    // Update task in store
    // updateTask(task._id, {
    //   childCount: newChildCount,
    //   completedChildCount: newCompletedChildCount
    // } as any)

    // Calculate total counts for the card (sum of all tasks)
    const allTasksForCard = tasks.filter(t => t.cardId === cardId)
    const totalChildCount = allTasksForCard.reduce((sum, t) => {
      // Use updated count for current task, existing count for others
      if (t._id === task._id) {
        return sum + newChildCount
      }
      return sum + (t.childCount || 0)
    }, 0)

    const totalCompletedChildCount = allTasksForCard.reduce((sum, t) => {
      // Use updated count for current task, existing count for others
      if (t._id === task._id) {
        return sum + newCompletedChildCount
      }
      return sum + (t.completedChildCount || 0)
    }, 0)

    // Update kanban-board card TaskDataCount
    setColumns(prev => prev.map(col => ({
      ...col,
      cards: col.cards.map(c =>
        c._id === cardId
          ? {
            ...c,
            TaskDataCount: {
              totalChildCount,
              totalCompletedChildCount
            }
          }
          : c
      )
    })))
  }

  // useEffect(() => {
  //   const handlechecklistUpdated = (playload) => {
  //     console.log("fdhjfsuh", playload)

  //     const itemId = playload._id

  //     const currentVal = playload.isCompleted
  //     if (playload?.completionData) {
  //       setchecklistitems(prev => prev.map(i => i._id === itemId ? { ...i, isCompleted: currentVal } : i));

  //       // Update local counts state
  //       setLocalCounts(prev => {
  //         const newCompleted = currentVal ? prev.completed + 1 : prev.completed - 1
  //         const newTotal = prev.total // Total doesn't change on toggle

  //         // Sync upstream
  //         // updateTaskAndCardCounts(newTotal, newCompleted)

  //         return { ...prev, completed: newCompleted }
  //       })
  //     }
  //     else {
  //       setchecklistitems(prev => prev.map(i => i._id === itemId ? { ...i, description: playload?.description } : i))
  //     }
  //   }
  //   console.log("playloadDelete", localCounts)
  //   const handlechecklistDeleted = (playload) => {
  //     console.log("playloadDeletesocket", playload)

  //     const itemId = playload._id
  //     const itemToDelete = checklistitems.find(i => i._id === itemId)
  //     if (!itemToDelete) return; // Should not happen

  //     // Optimistic Update
  //     setchecklistitems(prev => prev.filter(i => i._id !== itemId));
  //     setLocalCounts(prev => {
  //       const newTotal = prev.total - 1
  //       const newCompleted = itemToDelete.isCompleted ? prev.completed - 1 : prev.completed
  //       // updateTaskAndCardCounts(newTotal, newCompleted)
  //       return { total: newTotal, completed: newCompleted }
  //     });
  //   }


  //   const handlechecklistCreated = (playload) => {
  //     console.log("playloadDeletesocketConnwcasda", playload)
  //     if ((playload?.taskObj?._id) !== task._id) return;
  //     setchecklistitems(prev => [...prev, playload?.checklist])

  //     // Update local counts safely (assuming add always increases total by 1)
  //     setLocalCounts(prev => {
  //       const newTotal = prev.total + 1
  //       const newCompleted = prev.completed // new item is incomplete by default
  //       // Sync upstream
  //       // updateTaskAndCardCounts(newTotal, newCompleted)
  //       return { total: newTotal, completed: newCompleted }
  //     })
  //   }
  //   boardSocketService.on("checklist:created", handlechecklistCreated);
  //   boardSocketService.on("checklist:updated", handlechecklistUpdated);
  //   boardSocketService.on("checklist:deleted", handlechecklistDeleted);

  //   return () => {
  //     boardSocketService.off("checklist:created", handlechecklistCreated);
  //     boardSocketService.off("checklist:updated", handlechecklistUpdated);
  //     boardSocketService.off("checklist:deleted", handlechecklistDeleted);
  //   };
  // }, []);


  console.log("cjz7824", taskchild)


  // const updateTaskAndCardCounts = (newChildCount: number, newCompletedChildCount: number) => {
  //   // Update task in store
  //   // updateTask(task._id, {
  //   //   childCount: newChildCount,
  //   //   completedChildCount: newCompletedChildCount
  //   // } as any)

  //   // Calculate total counts for the card (sum of all tasks)
  //   const allTasksForCard = tasks.filter(t => t.cardId === cardId)
  //   const totalChildCount = allTasksForCard.reduce((sum, t) => {
  //     // Use updated count for current task, existing count for others
  //     if (t._id === task._id) {
  //       return sum + newChildCount
  //     }
  //     return sum + (t.childCount || 0)
  //   }, 0)

  //   const totalCompletedChildCount = allTasksForCard.reduce((sum, t) => {
  //     // Use updated count for current task, existing count for others
  //     if (t._id === task._id) {
  //       return sum + newCompletedChildCount
  //     }
  //     return sum + (t.completedChildCount || 0)
  //   }, 0)

  //   // Update kanban-board card TaskDataCount
  //   setColumns(prev => prev.map(col => ({
  //     ...col,
  //     cards: col.cards.map(c =>
  //       c._id === cardId
  //         ? {
  //           ...c,
  //           TaskDataCount: {
  //             totalChildCount,
  //             totalCompletedChildCount
  //           }
  //         }
  //         : c
  //     )
  //   })))
  // }

  const handleAddItem = async () => {
    if (!newItemInput.trim() || isAddingChecklistItem) return
    setIsAddingChecklistItem(true)
    const token = Cookies.get("auth-token");
    try {
      const response = await fetch(`https://uatapi.garage.app/flowboard/v1/tasks/${task._id}/checklists`, {
        method: "POST",
        headers: { "Content-Type": "application/json", Authorization: `Bearer ${token}` },
        body: JSON.stringify({ description: newItemInput, socketId: " boardSocketService.socketId" })
      });
      const data = await response.json();
      if (data.status) {
        // Calculate new values first
        const newItem = data.data

        setchecklistitems(prev => [...prev, newItem])

        // Update local counts safely (assuming add always increases total by 1)
        setLocalCounts(prev => {
          const newTotal = prev.total + 1
          const newCompleted = prev.completed // new item is incomplete by default
          // Sync upstream
          // updateTaskAndCardCounts(newTotal, newCompleted)
          return { total: newTotal, completed: newCompleted }
        })

        setColumns(prev => prev.map(col => ({
          ...col,
          cards: col.cards.map(c =>
            c._id === cardId
              ? {
                ...c,
                TaskDataCount: {
                  // Safely get current totalChildCount, default to 0
                  totalChildCount: (c.TaskDataCount?.totalChildCount ?? 0) + 1,
                  // Safely get current completed count, default to 0
                  totalCompletedChildCount: c.TaskDataCount?.totalCompletedChildCount ?? 0,
                },
              }
              : c
          )
        })));

        setNewItemInput("")
        toast.success("Item added")
      }
    } catch (e) {
      toast.error("Failed to add item")
    } finally {
      setIsAddingChecklistItem(false)
    }
  }
  console.log("lasdasd342", localCounts)
  const handleToggle = async (itemId: string, currentVal: boolean) => {
    // Prevent multiple toggles at once
    if (togglingItemId !== null) return

    setTogglingItemId(itemId)



    try {
      const token = Cookies.get("auth-token");
      const response = await fetch(`https://uatapi.garage.app/flowboard/v1/tasks/checklists/${itemId}/complete`, {
        method: "PUT",
        headers: { "Content-Type": "application/json", Authorization: `Bearer ${token}` },
        body: JSON.stringify({ isCompleted: !currentVal, socketId: "boardSocketService.socketId " })
      });
      const data = await response.json();
      if (!response.ok || data.status === false) {
        throw new Error(data.message || "Failed to update checklist item");
      }

      // Update items state
      setchecklistitems(prev => prev.map(i => i._id === itemId ? { ...i, isCompleted: !currentVal } : i));

      // Update local counts state
      setLocalCounts(prev => {
        const newCompleted = !currentVal ? prev.completed + 1 : prev.completed - 1
        const newTotal = prev.total // Total doesn't change on toggle

        // Sync upstream
        // updateTaskAndCardCounts(newTotal, newCompleted)

        return { ...prev, completed: newCompleted }
      })


      // const delta = payload.isCompleted ? 1 : -1; // +1 if now completed, -1 if now incomplete

      setColumns((prev) =>
        prev.map((col) => ({
          ...col,
          cards: col.cards.map((c) =>
            c._id === cardId
              ? {
                ...c,
                TaskDataCount: {
                  // Keep total child count unchanged (assuming toggle, not add/remove)
                  totalChildCount: c.TaskDataCount?.totalChildCount ?? 0,
                  // Update completed count
                  totalCompletedChildCount:
                    currentVal ? (c.TaskDataCount?.totalCompletedChildCount ?? 0) - 1 : (c.TaskDataCount?.totalCompletedChildCount ?? 0) + 1,
                },
              }
              : c
          ),
        }))
      );
      // setColumns(prev => prev.map(col => ({
      //   ...col,
      //   cards: col.cards.map(c =>
      //     c._id === cardId
      //       ? {
      //         ...c,
      //         TaskDataCount: {
      //           // Keep total child count unchanged (assuming toggle, not add/remove)
      //           totalChildCount: (c.TaskDataCount?.totalChildCount + 1 ?? 0),
      //           // Update completed count
      //           totalCompletedChildCount:
      //             (c.TaskDataCount?.totalCompletedChildCount ?? 0),
      //         },
      //       }
      //       : c
      //   )
      // })))

    } catch (e) {
      toast.error("Failed to update item");
    } finally {
      setTogglingItemId(null)
    }
  }

  const handleDeleteItem = async (itemId: string) => {


    const itemToDelete = checklistitems.find(i => i._id === itemId)
    if (!itemToDelete) return; // Should not happen

    // Optimistic Update

    try {
      const token = Cookies.get("auth-token");
      const response = await fetch(`https://uatapi.garage.app/flowboard/v1/tasks/checklists/${itemId}`, {
        method: "DELETE",
        headers: { Authorization: `Bearer ${token}` },
      });
      const data = await response.json();
      if (!response.ok || data.status === false) {
        throw new Error(data.message || "Failed to delete checklist item");
      }

      setchecklistitems(prev => prev.filter(i => i._id !== itemId));
      setLocalCounts(prev => {
        const newTotal = prev.total - 1
        const newCompleted = itemToDelete.isCompleted ? prev.completed - 1 : prev.completed
        // updateTaskAndCardCounts(newTotal, newCompleted)
        return { total: newTotal, completed: newCompleted }
      });

      setColumns((prev) =>
        prev.map((col) => ({
          ...col,
          cards: col.cards.map((c) =>
            c._id === cardId
              ? {
                ...c,
                TaskDataCount: {
                  // Keep total child count unchanged (assuming toggle, not add/remove)
                  totalChildCount: (c.TaskDataCount?.totalChildCount ?? 0) - 1,
                  // Update completed count
                  totalCompletedChildCount:
                    itemToDelete.isCompleted ? (c.TaskDataCount?.totalCompletedChildCount ?? 0) - 1 : (c.TaskDataCount?.totalCompletedChildCount ?? 0),
                },
              }
              : c
          ),
        }))
      );
      // Success, state already updated optimistically
    } catch (e) {
      toast.error("Failed to delete item");
      // Revert if failed (optional, but good practice). For now leaving as is to focus on the 'not updating' fix.
    }
  }

  const handleLoadMoreChecklists = async () => {
    if (isLoadingMoreChecklists || !hasMoreChecklists) return

    setIsLoadingMoreChecklists(true)
    try {
      const token = Cookies.get("auth-token");
      const nextPage = checklistCurrentPage + 1
      const response = await fetch(
        `https://uatapi.garage.app/flowboard/v1/tasks/checklists/?size=10&page=${nextPage}&boardId=${boardId}&taskId=${task._id}`,
        {
          method: "GET",
          headers: { Authorization: `Bearer ${token}` },
        }
      );
      const data = await response.json();
      if (!response.ok || data.status === false) {
        throw new Error(data.message || "Failed to load more checklist items");
      }

      // Append new items
      const newItems = Array.isArray(data.data) ? data.data : []
      setchecklistitems(prev => [...prev, ...newItems])

      // Update pagination state
      const metadata = data.metadata || {}
      const currentPage = metadata.currentPage ?? nextPage
      const totalPages = metadata.totalPages ?? currentPage
      const hasMore = currentPage < totalPages

      setChecklistCurrentPage(currentPage)
      setChecklistTotalPages(totalPages)
      setHasMoreChecklists(hasMore)
    } catch (e: any) {
      toast.error(e.message || "Failed to load more items");
    } finally {
      setIsLoadingMoreChecklists(false)
    }
  }

  // Task Title Updates
  const handleSaveTitle = async () => {
    if (titleInput.trim()) {
      updateTask(task._id, { name: titleInput, socketId: undefined })

      setTitleInput(task.name) // Revert if empty or unchanged

      setIsEditingTitle(false)
    }
  }

  const handleCancelTitleEdit = () => {
    setTitleInput(task.name)
    setIsEditingTitle(false)
  }

  // Checklist Item Updates
  const startEditingItem = (item: any) => {
    setEditingItemId(item._id)
    setEditItemValue(item.description)
  }

  const cancelEditingItem = () => {
    setEditingItemId(null)
    setEditItemValue("")
  }

  const saveEditingItem = async (itemId: string) => {
    if (!editItemValue.trim()) return

    // Optimistic update
    setchecklistitems(prev => prev.map(i => i._id === itemId ? { ...i, description: editItemValue } : i))
    setEditingItemId(null)

    try {
      const token = Cookies.get("auth-token");
      await fetch(`https://uatapi.garage.app/flowboard/v1/tasks/checklists/${itemId}`, {
        method: "PUT",
        headers: { "Content-Type": "application/json", Authorization: `Bearer ${token}` },
        body: JSON.stringify({ description: editItemValue, socketId: "boardSocketService.socketId " })
      });
      toast.success("Item updated")
    } catch (e) {
      toast.error("Failed to update item")
      // We might want to revert here, but it requires keeping specific old value. 
      // For simplicity we'll assume success or user can edit again.
    }
  }

  const completedCount = localCounts.completed
  const totalCount = localCounts.total
  const progress = totalCount > 0 ? (completedCount / totalCount) * 100 : 0
  console.log("localCounts", localCounts)
  return (
    <div className="bg-transparent rounded-lg shadow-sm border border-[#e5e7eb29] p-4 mb-4" key={task?._id}>
      {/* Header with Tasks title and progress count */}
      <div className="flex items-center justify-between mb-3">
        <div className="flex items-center gap-2">
          {isEditingTitle ? (
            <div className="flex items-center gap-1 flex-1">
              <input
                value={titleInput}
                onChange={(e) => setTitleInput(e.target.value)}
                onKeyDown={(e) => e.key === 'Enter' && handleSaveTitle()}
                onBlur={(e) => e.target.blur()}
                className="font-semibold text-white/50 text-xs border-b border-white/20 focus:outline-none flex-1 min-w-0 bg-transparent"
                autoFocus
              />
              <button onClick={handleSaveTitle} className="p-1 hover:bg-white/10 rounded text-green-500"><Check className="w-4 h-4" /></button>
              <button onClick={handleCancelTitleEdit} className="p-1 hover:bg-white/10 rounded text-red-500"><X className="w-4 h-4" /></button>
            </div>
          ) : (
            <h3
              onClick={() => !isReadOnly && setIsEditingTitle(true)}
              className="font-semibold text-white/50 text-xs cursor-pointer hover:bg-white/10 rounded px-1 -ml-1"
            >
              {task.name}
            </h3>
          )}
        </div>
        <div className="flex items-center gap-2">
          <span className="text-xs text-white/50 font-medium">{completedCount}/{totalCount}</span>
          {!isEditingTitle && !isReadOnly && (
            <button
              onClick={() => { if (confirm("Delete task?")) deleteTask(task._id, "boardSocketService.socketId") }}
              className="text-white/50 hover:text-red-500 transition"
            >
              <Trash2 className="w-4 h-4" />
            </button>
          )}
        </div>
      </div>

      {/* Progress Bar */}
      <div className="mb-4">
        <div className="w-full bg-white/10 rounded-full h-2 overflow-hidden">
          <div
            className="bg-blue-500 h-full transition-all duration-300 rounded-full"
            style={{ width: `${progress}%` }}
          ></div>
        </div>
      </div>

      {/* Checklist Items */}
      <div className="space-y-2 mb-4">
        {checklistitems.map(item => (
          <div key={item._id} className="flex items-center gap-3 group">
            {editingItemId === item._id ? (
              <div className="flex items-center gap-2 flex-1 w-full">
                <input
                  value={editItemValue}
                  onChange={(e) => setEditItemValue(e.target.value)}
                  onKeyDown={(e) => e.key === 'Enter' && saveEditingItem(item._id)}
                  onBlur={(e) => e.target.blur()}
                  className="text-xs text-white/50 flex-1 border-b border-white/20 focus:outline-none py-1 bg-transparent"
                  autoFocus
                />
                <button onClick={() => saveEditingItem(item._id)} className="p-1 hover:bg-white/10 rounded text-green-500"><Check className="w-4 h-4" /></button>
                <button onClick={cancelEditingItem} className="p-1 hover:bg-white/10 rounded text-red-500"><X className="w-4 h-4" /></button>
              </div>
            ) : (
              <>
                <div className="relative flex-shrink-0">
                  <input
                    type="checkbox"
                    checked={item.isCompleted}
                    onChange={() => !isReadOnly && handleToggle(item._id, item.isCompleted)}
                    disabled={isReadOnly || togglingItemId !== null}
                    className="w-4 h-4 rounded border-[#e5e7eb29] accent-blue-500 bg-transparent focus:ring-blue-500 cursor-pointer flex-shrink-0 disabled:opacity-50 disabled:cursor-not-allowed"
                  />
                  {togglingItemId === item._id && (
                    <div className="absolute inset-0 flex items-center justify-center">
                      <div className="w-3 h-3 border-2 border-white/20 border-t-transparent rounded-full animate-spin"></div>
                    </div>
                  )}
                </div>
                <span
                  onClick={() => !isReadOnly && startEditingItem(item)}
                  className={`text-xs text-white/50 flex-1 cursor-pointer hover:bg-white/10 px-1 rounded -ml-1 ${togglingItemId !== null ? 'opacity-50' : ''}`}
                >
                  {item.description}
                </span>
                {!isReadOnly && togglingItemId === null && (
                  <button
                    onClick={() => handleDeleteItem(item._id)}
                    className="opacity-0 group-hover:opacity-100 text-white/50 hover:text-red-500 transition flex-shrink-0"
                  >
                    <Trash2 className="w-4 h-4" />
                  </button>
                )}
              </>
            )}
          </div>
        ))}
      </div>
      {
        taskchild?.childCount > 10 && hasMoreChecklists &&
        <div className="">
          <button
            onClick={handleLoadMoreChecklists}
            disabled={isLoadingMoreChecklists}
            className="w-full text-xs text-white/50 font-medium py-2 disabled:opacity-60 disabled:cursor-not-allowed"
          >
            {isLoadingMoreChecklists ? "Loading..." : "Load More"}
          </button>
        </div>
      }

      {/* Add New Item Section */}
      {
        !isReadOnly && (
          <div className="flex gap-2">
            <input
              placeholder="Add an item..."
              value={newItemInput}
              onChange={(e) => setNewItemInput(e.target.value)}
              onKeyDown={(e) => e.key === 'Enter' && handleAddItem()}
              onBlur={(e) => e.target.blur()}
              disabled={isAddingChecklistItem}
              className="text-xs px-3 py-2 border border-[#e5e7eb29] rounded-lg flex-1 focus:outline-none focus:ring-1 focus:ring-white/20 disabled:opacity-60 disabled:cursor-not-allowed bg-transparent text-white/50"
            />
            <button
              onClick={handleAddItem}
              disabled={isAddingChecklistItem || !newItemInput.trim()}
              className="bg-white/10 text-white/50 px-4 py-2 rounded-lg text-xs font-medium hover:bg-white/20 transition disabled:opacity-60 disabled:cursor-not-allowed"
            >
              {isAddingChecklistItem ? "Adding..." : "Add"}
            </button>
          </div>
        )
      }

      {/* Load More button for checklist items */}

    </div >
  )
}
