                      await updateCard(card._id, { name: cardName, socketId });
                      // Optimistic update
                      setColumns((prev) =>
                        prev.map((col) => ({
                          ...col,
                          cards: col.cards.map((c) =>
                            c._id === card._id ? { ...c, name: cardName } : c
                          ),
                        }))
                      );
                    }
                  }}
                  disabled={isReadOnly}
                  className="
      w-full text-lg font-bold 
      text-white/50 dark:text-white/50
      bg-transparent 
      outline-none
      border-b border-transparent 
      focus:border-transparent 
      focus:ring-0 focus:outline-none focus:shadow-none
      transition-colors
