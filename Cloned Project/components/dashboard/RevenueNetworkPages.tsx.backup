interface ComingSoonPageProps {
  title: string;
  icon: React.ReactNode;
  description?: string;
}

function ComingSoonPage({ title, icon, description }: ComingSoonPageProps) {
  return (
    <div className="h-full w-full flex flex-col items-center justify-center p-8">
      <div className="flex flex-col items-center gap-6 max-w-md text-center">
        <div className="w-20 h-20 rounded-full bg-[#1a1a22] border border-[#2a2a35] flex items-center justify-center text-[#FBD10D]">
          {icon}
        </div>
        <div className="space-y-2">
          <h2 className="text-2xl font-semibold text-white">{title}</h2>
          <p className="text-sm text-[#9fa0b8]">
            {description || "This feature is under development and will be available soon."}
